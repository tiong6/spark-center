// Spark Center（選用）：讓管理員群組（sudo）不用密碼就能重啟 dgx-dashboard-admin.service，
// 這樣裝完更新後 Spark Center 可以自動叫 DGX Dashboard 重查「有沒有更新」（它自己的快照常常過期）。
// 只放行這一個單元的 restart，其他 systemd 操作照舊要驗證。
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "dgx-dashboard-admin.service" &&
      action.lookup("verb") == "restart" &&
      subject.isInGroup("sudo")) {
    return polkit.Result.YES;
  }
});
